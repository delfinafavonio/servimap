DATABASE_URL="postgresql://postgres:CAMBIAR_ESTA_CLAVE@localhost:5432/servimap?schema=public"
PORT=3000
JWT_SECRET="GENERAR_UN_SECRETO_LARGO_Y_ALEATORIO"
JWT_EXPIRES_IN="8h"
CORS_ORIGIN="http://localhost:5173,https://servimap.vercel.app,https://servimap-*.vercel.app"

# Producción (Render + Neon): NODE_ENV=production, DATABASE_URL con sslmode=require
# y CORS_ORIGIN con los orígenes de Vercel, separados por comas y sin barra final.
NODE_ENV="development"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Opcional: si se omite, test:integration deriva servimap_test desde DATABASE_URL.
TEST_DATABASE_URL=""
TEST_JWT_SECRET=""

# Sólo para npm run seed:demo. Definir valores locales; nunca versionar claves reales.
DEMO_ADMIN_EMAIL=""
DEMO_ADMIN_PASSWORD=""
DEMO_CLIENT_EMAIL=""
DEMO_CLIENT_PASSWORD=""
DEMO_PROVIDER_EMAIL=""
DEMO_PROVIDER_PASSWORD=""
